[Unit]
Description=Foreclosure CivilView bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/foreclosure-bridge
Environment=NODE_ENV=production
Environment=FORECLOSURE_HOST=127.0.0.1
Environment=FORECLOSURE_PORT=3001
ExecStart=/usr/bin/node /opt/foreclosure-bridge/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
