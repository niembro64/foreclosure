# The existing /foreclosure/ static-file location can remain unchanged. The NJ
# workflow additionally needs this API location routed to `npm run serve`.
location ^~ /api/ {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 45s;
}

# Optional: let the Node process serve the compiled React app too.
# location /foreclosure/ {
#     proxy_pass http://127.0.0.1:3001;
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
# }
